{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": []
  },
  "include": [
    "next-env.d.ts",
    "lib/**/*.ts",
    "app/api/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "app/page.tsx",
    "app/layout.tsx",
    "app/globals.css",
    "components/**",
    "hooks/**"
  ]
}
