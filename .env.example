# Copy to .env.local for local development (never commit .env.local):
#   cp .env.example .env.local
#
# Get a key from Google AI Studio (NOT a Vertex-only GCP key):
#   https://aistudio.google.com/apikey
#
# Do NOT set GOOGLE_GENAI_USE_VERTEXAI=true for this project — Argus uses the
# Gemini Developer API. The server client also forces vertexai: false.
GEMINI_API_KEY=
