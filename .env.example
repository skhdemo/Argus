# Copy to .env.local for local development (never commit .env.local):
#   cp .env.example .env.local
#
# Get a key from Google AI Studio (NOT a Vertex-only GCP key):
#   https://aistudio.google.com/apikey
#
# Do NOT set GOOGLE_GENAI_USE_VERTEXAI=true for this project — Argus uses the
# Gemini Developer API. The server client also forces vertexai: false.
GEMINI_API_KEY=

# Evidence verification (Google Search grounding) — async, not on /api/extract
ARGUS_VERIFY_ENABLED=true
# In-process concurrency (FE must also serialize globally across instances)
ARGUS_VERIFY_CONCURRENCY=1
# Optional override; defaults to the pinned GEMINI_MODEL
# GEMINI_VERIFY_MODEL=gemini-3-flash-preview
